{
  "name": "finanse",
  "version": "0.1.0",
  "private": true,
  "description": "Prywatny system zarządzania finansami osobistymi",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "audit": "node scripts/audit-excel.mjs",
    "audit:csv": "node scripts/audit-csv.mjs",
    "import:excel": "node scripts/import-excel.mjs",
    "import:excel:dry": "node scripts/import-excel.mjs --dry-run",
    "test": "node --experimental-strip-types --test src/lib/balances/*.test.ts src/lib/import/*.test.ts src/lib/transactions/*.test.ts",
    "verify:balances": "node scripts/verify-balances.mjs",
    "reconcile:balances": "node scripts/reconcile-balances.mjs",
    "clear:all": "node scripts/clear-all-data.mjs --yes",
    "db:migrate:10": "node scripts/apply-migration-10.mjs",
    "db:migrate:11": "node scripts/apply-migration-11.mjs",
    "setup:all": "node scripts/run-all.mjs",
    "setup:all:force": "node scripts/run-all.mjs --force-import",
    "db:push": "supabase db push",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:api": "node scripts/apply-migrations-api.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^5.8.8",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "pg": "^8.21.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
